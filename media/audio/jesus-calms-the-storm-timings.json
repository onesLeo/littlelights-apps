{"text": "In…", "start": 183.54, "end": 183.72, "words": [{"text": "In…", "start": 183.54, "end": 183.72}]},
{"text": "and out.", "start": 184.84, "end": 185.5, "words": [{"text": "and", "start": 184.84, "end": 185}, {"text": "out.", "start": 185.1, "end": 185.5}]},
{"text": "Let's pray.", "start": 187.04, "end": 187.62, "words": [{"text": "Let's", "start": 187.04, "end": 187.26}, {"text": "pray.", "start": 187.3, "end": 187.62}]},
{"text": "Dear Jesus…", "start": 188.38, "end": 189.12, "words": [{"text": "Dear", "start": 188.38, "end": 188.56}, {"text": "Jesus…", "start": 188.64, "end": 189.12}]},
{"text": "thank You that You are with me, even when I feel scared.", "start": 189.74, "end": 192.84, "words": [{"text": "thank", "start": 189.74, "end": 189.98}, {"text": "You", "start": 190.06, "end": 190.16}, {"text": "that", "start": 190.22, "end": 190.38}, {"text": "You", "start": 190.44, "end": 190.54}, {"text": "are", "start": 190.58, "end": 190.68}, {"text": "with", "start": 190.74, "end": 190.94}, {"text": "me,", "start": 191.02, "end": 191.14}, {"text": "even", "start": 191.52, "end": 191.76}, {"text": "when", "start": 191.8, "end": 191.9}, {"text": "I", "start": 191.98, "end": 192.04}, {"text": "feel", "start": 192.1, "end": 192.32}, {"text": "scared.", "start": 192.38, "end": 192.84}]},
{"text": "When a storm comes, help my heart to be calm.", "start": 193.28, "end": 196.16, "words": [{"text": "When", "start": 193.28, "end": 193.36}, {"text": "a", "start": 193.42, "end": 193.46}, {"text": "storm", "start": 193.56, "end": 193.86}, {"text": "comes,", "start": 193.92, "end": 194.32}, {"text": "help", "start": 194.76, "end": 194.96}, {"text": "my", "start": 195, "end": 195.14}, {"text": "heart", "start": 195.2, "end": 195.44}, {"text": "to", "start": 195.48, "end": 195.56}, {"text": "be", "start": 195.6, "end": 195.72}, {"text": "calm.", "start": 195.78, "end": 196.16}]},
