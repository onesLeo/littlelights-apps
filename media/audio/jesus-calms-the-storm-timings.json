{"text": "“Peace!", "start": 177.12, "end": 177.62, "words": [{"text": "“Peace!", "start": 177.12, "end": 177.62}]},
{"text": "Be still!”", "start": 178, "end": 178.64, "words": [{"text": "Be", "start": 178, "end": 178.14}, {"text": "still!”", "start": 178.3, "end": 178.64}]},
