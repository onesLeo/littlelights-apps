{"text": "One star for night one.", "start": 222.08, "end": 223.68, "words": [{"text": "One", "start": 222.08, "end": 222.38}, {"text": "star", "start": 222.38, "end": 222.7}, {"text": "for", "start": 222.7, "end": 223.1}, {"text": "night", "start": 223.1, "end": 223.34}, {"text": "one.", "start": 223.34, "end": 223.68}]},
