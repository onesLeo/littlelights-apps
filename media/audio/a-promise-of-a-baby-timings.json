{"text": "The Bible says: \"For a child is born to us.", "start": 135.76, "end": 139.3, "words": [{"text": "The", "start": 135.76, "end": 135.84}, {"text": "Bible", "start": 135.84, "end": 136.14}, {"text": "says:", "start": 136.14, "end": 136.6}, {"text": "\"For", "start": 137.48, "end": 137.48}, {"text": "a", "start": 137.48, "end": 137.66}, {"text": "child", "start": 137.66, "end": 138.06}, {"text": "is", "start": 138.06, "end": 138.42}, {"text": "born", "start": 138.42, "end": 138.72}, {"text": "to", "start": 138.72, "end": 139.0}, {"text": "us.", "start": 139.0, "end": 139.3}]},
