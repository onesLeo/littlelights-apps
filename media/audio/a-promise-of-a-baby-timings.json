{"text": "His name will be called Wonderful Counselor, Mighty God, Everlasting Father, Prince of Peace.\"", "start": 144.88, "end": 152.34, "words": [{"text": "His", "start": 144.88, "end": 145.02}, {"text": "name", "start": 145.02, "end": 145.34}, {"text": "will", "start": 145.34, "end": 145.56}, {"text": "be", "start": 145.56, "end": 145.72}, {"text": "called", "start": 145.72, "end": 146.1}, {"text": "Wonderful", "start": 146.1, "end": 146.84}, {"text": "Counselor,", "start": 146.84, "end": 147.78}, {"text": "Mighty", "start": 148.14, "end": 148.56}, {"text": "God,", "start": 148.56, "end": 148.98}, {"text": "Everlasting", "start": 149.62, "end": 150.18}, {"text": "Father,", "start": 150.18, "end": 150.6}, {"text": "Prince", "start": 151.34, "end": 151.54}, {"text": "of", "start": 151.54, "end": 151.96}, {"text": "Peace.\"", "start": 151.96, "end": 152.34}]},
