{"text": "A child…", "start": 159.16, "end": 159.8, "words": [{"text": "A", "start": 159.16, "end": 159.4}, {"text": "child…", "start": 159.4, "end": 159.8}]},
{"text": "a son…", "start": 160.6, "end": 161.1, "words": [{"text": "a", "start": 160.6, "end": 160.68}, {"text": "son…", "start": 160.68, "end": 161.1}]},
{"text": "a promise from God.", "start": 161.72, "end": 162.78, "words": [{"text": "a", "start": 161.72, "end": 161.78}, {"text": "promise", "start": 161.78, "end": 162.14}, {"text": "from", "start": 162.14, "end": 162.44}, {"text": "God.", "start": 162.44, "end": 162.78}]},
