{"text": "Let's pray.", "start": 228.3, "end": 228.94, "words": [{"text": "Let's", "start": 228.3, "end": 228.64}, {"text": "pray.", "start": 228.64, "end": 228.94}]},
{"text": "Dear Jesus…", "start": 229.92, "end": 230.52, "words": [{"text": "Dear", "start": 229.92, "end": 230.04}, {"text": "Jesus…", "start": 230.04, "end": 230.52}]},
