{"text": "Help us get ready for Your birthday.", "start": 233.68, "end": 235.94, "words": [{"text": "Help", "start": 233.68, "end": 234.56}, {"text": "us", "start": 234.56, "end": 234.78}, {"text": "get", "start": 234.78, "end": 234.94}, {"text": "ready", "start": 234.94, "end": 235.22}, {"text": "for", "start": 235.22, "end": 235.42}, {"text": "Your", "start": 235.42, "end": 235.56}, {"text": "birthday.", "start": 235.56, "end": 235.94}]},
