{"text": "She was back in her bed, and Mummy and Papa were right beside her.", "start": 166.32, "end": 170.14, "words": [{"text": "She", "start": 166.32, "end": 166.44}, {"text": "was", "start": 166.44, "end": 166.6}, {"text": "back", "start": 166.6, "end": 166.9}, {"text": "in", "start": 166.9, "end": 167.08}, {"text": "her", "start": 167.08, "end": 167.2}, {"text": "bed,", "start": 167.2, "end": 167.44}, {"text": "and", "start": 167.88, "end": 168.04}, {"text": "Mummy", "start": 168.04, "end": 168.28}, {"text": "and", "start": 168.28, "end": 168.56}, {"text": "Papa", "start": 168.56, "end": 168.82}, {"text": "were", "start": 168.82, "end": 169.12}, {"text": "right", "start": 169.12, "end": 169.44}, {"text": "beside", "start": 169.44, "end": 169.76}, {"text": "her.", "start": 169.76, "end": 170.14}]},
