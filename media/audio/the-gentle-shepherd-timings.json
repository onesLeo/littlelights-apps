{"text": "\"Mummy, who is the gentle shepherd?\"", "start": 152.16, "end": 154.34, "words": [{"text": "\"Mummy,", "start": 152.16, "end": 152.46}, {"text": "who", "start": 153.04, "end": 153.34}, {"text": "is", "start": 153.34, "end": 153.5}, {"text": "the", "start": 153.5, "end": 153.66}, {"text": "gentle", "start": 153.66, "end": 153.96}, {"text": "shepherd?\"", "start": 153.96, "end": 154.34}]},
{"text": "\"It's Jesus,\" said Mummy.", "start": 155.2, "end": 156.94, "words": [{"text": "\"It's", "start": 155.2, "end": 155.52}, {"text": "Jesus,\"", "start": 155.52, "end": 155.88}, {"text": "said", "start": 156.4, "end": 156.68}, {"text": "Mummy.", "start": 156.68, "end": 156.94}]},
{"text": "\"When you feel tired, or small, or a little bit sad, Jesus carries you close to His heart, just like that lamb.\"", "start": 157.58, "end": 164.88, "words": [{"text": "\"When", "start": 157.58, "end": 157.72}, {"text": "you", "start": 157.72, "end": 157.86}, {"text": "feel", "start": 157.86, "end": 158.1}, {"text": "tired,", "start": 158.1, "end": 158.58}, {"text": "or", "start": 158.58, "end": 159.08}, {"text": "small,", "start": 159.08, "end": 159.5}, {"text": "or", "start": 159.5, "end": 160.12}, {"text": "a", "start": 160.12, "end": 160.22}, {"text": "little", "start": 160.22, "end": 160.4}, {"text": "bit", "start": 160.4, "end": 160.58}, {"text": "sad,", "start": 160.58, "end": 160.96}, {"text": "Jesus", "start": 161.6, "end": 161.84}, {"text": "carries", "start": 161.84, "end": 162.3}, {"text": "you", "start": 162.3, "end": 162.54}, {"text": "close", "start": 162.54, "end": 162.86}, {"text": "to", "start": 162.86, "end": 163.12}, {"text": "His", "start": 163.12, "end": 163.28}, {"text": "heart,", "start": 163.28, "end": 163.66}, {"text": "just", "start": 163.96, "end": 164.16}, {"text": "like", "start": 164.16, "end": 164.42}, {"text": "that", "start": 164.42, "end": 164.62}, {"text": "lamb.\"", "start": 164.62, "end": 164.88}]},
{"text": "\"Christmas is coming!\"", "start": 165.42, "end": 166.44, "words": [{"text": "\"Christmas", "start": 165.42, "end": 165.8}, {"text": "is", "start": 165.8, "end": 166.14}, {"text": "coming!\"", "start": 166.14, "end": 166.44}]},
{"text": "said Papa.", "start": 166.86, "end": 167.38, "words": [{"text": "said", "start": 166.86, "end": 167.06}, {"text": "Papa.", "start": 167.06, "end": 167.38}]},
{"text": "\"Tomorrow, let's share or help someone smaller, just like He does.\"", "start": 167.96, "end": 171.58, "words": [{"text": "\"Tomorrow,", "start": 167.96, "end": 168.22}, {"text": "let's", "start": 168.62, "end": 168.94}, {"text": "share", "start": 168.94, "end": 169.2}, {"text": "or", "start": 169.2, "end": 169.44}, {"text": "help", "start": 169.44, "end": 169.66}, {"text": "someone", "start": 169.66, "end": 170.02}, {"text": "smaller,", "start": 170.02, "end": 170.56}, {"text": "just", "start": 170.74, "end": 170.98}, {"text": "like", "start": 170.98, "end": 171.18}, {"text": "He", "start": 171.18, "end": 171.38}, {"text": "does.\"", "start": 171.38, "end": 171.58}]},
{"text": "\"I'll help the little ones at Sunday school!\"", "start": 172.12, "end": 174.04, "words": [{"text": "\"I'll", "start": 172.12, "end": 172.42}, {"text": "help", "start": 172.42, "end": 172.6}, {"text": "the", "start": 172.6, "end": 172.8}, {"text": "little", "start": 172.8, "end": 172.92}, {"text": "ones", "start": 172.92, "end": 173.14}, {"text": "at", "start": 173.14, "end": 173.3}, {"text": "Sunday", "start": 173.3, "end": 173.6}, {"text": "school!\"", "start": 173.6, "end": 174.04}]},
{"text": "said Ema.", "start": 174.32, "end": 174.88, "words": [{"text": "said", "start": 174.32, "end": 174.6}, {"text": "Ema.", "start": 174.6, "end": 174.88}]},
{"text": "What about you, little one?", "start": 175.46, "end": 176.56, "words": [{"text": "What", "start": 175.46, "end": 175.64}, {"text": "about", "start": 175.64, "end": 175.84}, {"text": "you,", "start": 175.84, "end": 176.08}, {"text": "little", "start": 176.14, "end": 176.3}, {"text": "one?", "start": 176.3, "end": 176.56}]},
{"text": "Who could you help, or share with, tomorrow?", "start": 176.56, "end": 179.2, "words": [{"text": "Who", "start": 176.56, "end": 177.18}, {"text": "could", "start": 177.18, "end": 177.4}, {"text": "you", "start": 177.4, "end": 177.58}, {"text": "help,", "start": 177.58, "end": 177.92}, {"text": "or", "start": 177.92, "end": 178.18}, {"text": "share", "start": 178.18, "end": 178.5}, {"text": "with,", "start": 178.5, "end": 178.74}, {"text": "tomorrow?", "start": 178.74, "end": 179.2}]},
{"text": "That's a lovely idea.", "start": 182.82, "end": 184.56, "words": [{"text": "That's", "start": 182.82, "end": 183.56}, {"text": "a", "start": 183.56, "end": 183.68}, {"text": "lovely", "start": 183.68, "end": 184.1}, {"text": "idea.", "start": 184.1, "end": 184.56}]},
{"text": "You know, little one…", "start": 186.98, "end": 188.34, "words": [{"text": "You", "start": 186.98, "end": 187.26}, {"text": "know,", "start": 187.26, "end": 187.5}, {"text": "little", "start": 187.84, "end": 188.02}, {"text": "one…", "start": 188.02, "end": 188.34}]},
{"text": "you are one of Jesus' little lambs.", "start": 189.08, "end": 191.64, "words": [{"text": "you", "start": 189.08, "end": 189.36}, {"text": "are", "start": 189.36, "end": 189.66}, {"text": "one", "start": 189.66, "end": 189.88}, {"text": "of", "start": 189.88, "end": 190.02}, {"text": "Jesus'", "start": 190.02, "end": 190.36}, {"text": "little", "start": 190.7, "end": 190.98}, {"text": "lambs.", "start": 190.98, "end": 191.64}]},
{"text": "He knows your name, and He never leaves you behind.", "start": 192.2, "end": 195.22, "words": [{"text": "He", "start": 192.2, "end": 192.34}, {"text": "knows", "start": 192.34, "end": 192.62}, {"text": "your", "start": 192.62, "end": 192.88}, {"text": "name,", "start": 192.88, "end": 193.24}, {"text": "and", "start": 193.62, "end": 193.8}, {"text": "He", "start": 193.8, "end": 193.92}, {"text": "never", "start": 193.92, "end": 194.32}, {"text": "leaves", "start": 194.32, "end": 194.66}, {"text": "you", "start": 194.66, "end": 194.84}, {"text": "behind.", "start": 194.84, "end": 195.22}]},
{"text": "Can you give yourself a gentle hug, like the shepherd hugging his lamb?", "start": 196.34, "end": 199.96, "words": [{"text": "Can", "start": 196.34, "end": 196.52}, {"text": "you", "start": 196.52, "end": 196.66}, {"text": "give", "start": 196.66, "end": 196.82}, {"text": "yourself", "start": 196.82, "end": 197.24}, {"text": "a", "start": 197.24, "end": 197.46}, {"text": "gentle", "start": 197.46, "end": 197.74}, {"text": "hug,", "start": 197.74, "end": 198.16}, {"text": "like", "start": 198.56, "end": 198.66}, {"text": "the", "start": 198.66, "end": 198.82}, {"text": "shepherd", "start": 198.82, "end": 199.1}, {"text": "hugging", "start": 199.1, "end": 199.46}, {"text": "his", "start": 199.46, "end": 199.72}, {"text": "lamb?", "start": 199.72, "end": 199.96}]},
{"text": "Mmm…", "start": 201.62, "end": 202.06, "words": [{"text": "Mmm…", "start": 201.62, "end": 202.06}]},
{"text": "that's it.", "start": 202.5, "end": 203.1, "words": [{"text": "that's", "start": 202.5, "end": 202.94}, {"text": "it.", "start": 202.94, "end": 203.1}]},
{"text": "Ema hugged her paper lamb, and they all held hands.", "start": 204.0, "end": 207.26, "words": [{"text": "Ema", "start": 204.0, "end": 204.26}, {"text": "hugged", "start": 204.26, "end": 204.76}, {"text": "her", "start": 204.76, "end": 204.86}, {"text": "paper", "start": 204.86, "end": 205.16}, {"text": "lamb,", "start": 205.16, "end": 205.56}, {"text": "and", "start": 205.94, "end": 206.06}, {"text": "they", "start": 206.06, "end": 206.18}, {"text": "all", "start": 206.18, "end": 206.54}, {"text": "held", "start": 206.54, "end": 206.8}, {"text": "hands.", "start": 206.8, "end": 207.26}]},
{"text": "Let's pray.", "start": 208.26, "end": 209.02, "words": [{"text": "Let's", "start": 208.26, "end": 208.72}, {"text": "pray.", "start": 208.72, "end": 209.02}]},
{"text": "Dear Jesus…", "start": 210.04, "end": 210.6, "words": [{"text": "Dear", "start": 210.04, "end": 210.2}, {"text": "Jesus…", "start": 210.2, "end": 210.6}]},
{"text": "thank You for carrying me.", "start": 211.36, "end": 212.82, "words": [{"text": "thank", "start": 211.36, "end": 211.68}, {"text": "You", "start": 211.68, "end": 211.88}, {"text": "for", "start": 211.88, "end": 212.06}, {"text": "carrying", "start": 212.06, "end": 212.5}, {"text": "me.", "start": 212.5, "end": 212.82}]},
{"text": "Help me care for others.", "start": 213.48, "end": 214.58, "words": [{"text": "Help", "start": 213.48, "end": 213.62}, {"text": "me", "start": 213.62, "end": 213.82}, {"text": "care", "start": 213.82, "end": 214.06}, {"text": "for", "start": 214.06, "end": 214.3}, {"text": "others.", "start": 214.3, "end": 214.58}]},
{"text": "Amen.", "start": 215.4, "end": 215.64, "words": [{"text": "Amen.", "start": 215.4, "end": 215.64}]},
{"text": "Goodnight, little light.", "start": 216.6, "end": 218.0, "words": [{"text": "Goodnight,", "start": 216.6, "end": 217.36}, {"text": "little", "start": 217.54, "end": 217.64}, {"text": "light.", "start": 217.64, "end": 218.0}]},
{"text": "Sleep tight.", "start": 218.58, "end": 219.04, "words": [{"text": "Sleep", "start": 218.58, "end": 218.7}, {"text": "tight.", "start": 218.7, "end": 219.04}]},
{"text": "Nineteen more nights to go.", "start": 219.8, "end": 221.2, "words": [{"text": "Nineteen", "start": 219.8, "end": 220.32}, {"text": "more", "start": 220.32, "end": 220.48}, {"text": "nights", "start": 220.48, "end": 220.74}, {"text": "to", "start": 220.74, "end": 220.96}, {"text": "go.", "start": 220.96, "end": 221.2}]}
]
