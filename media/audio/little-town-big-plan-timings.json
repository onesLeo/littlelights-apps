{"text": "\"Let's each say three little things we're thankful for.\"", "start": 168.3, "end": 170.8, "words": [{"text": "\"Let's", "start": 168.3, "end": 168.58}, {"text": "each", "start": 168.58, "end": 168.76}, {"text": "say", "start": 168.76, "end": 169.04}, {"text": "three", "start": 169.04, "end": 169.4}, {"text": "little", "start": 169.4, "end": 169.64}, {"text": "things", "start": 169.64, "end": 169.9}, {"text": "we're", "start": 169.9, "end": 170.2}, {"text": "thankful", "start": 170.2, "end": 170.42}, {"text": "for.\"", "start": 170.42, "end": 170.8}]},
