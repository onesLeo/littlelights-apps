# Response headers for Cloudflare Pages (copied into dist/ by scripts/build-pages.mjs).
# https://developers.cloudflare.com/pages/configuration/headers/
# The Supabase address in the policy must match supabaseUrl in js/config.js (tests/build.mjs checks it).
# Cloudflare Web Analytics (website only): beacon script from static.cloudflareinsights.com, reports to cloudflareinsights.com.
# Built-in reel videos stream from https://media.littlesaltandlight.com (Cloudflare R2, media-src).
# YouTube reels are embedded only from youtube-nocookie (frame-src) with thumbnails from i.ytimg.com.
# style-src allows inline style="" attributes (the app sets colours and sizes with them); style-src-elem
# still blocks inline <style> blocks in browsers that support it. No inline scripts are allowed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; font-src 'self'; img-src 'self' data: blob: https://svlvlmyugyadmehjwudm.supabase.co https://i.ytimg.com; media-src 'self' data: blob: https://svlvlmyugyadmehjwudm.supabase.co https://media.littlesaltandlight.com; connect-src 'self' https://svlvlmyugyadmehjwudm.supabase.co wss://svlvlmyugyadmehjwudm.supabase.co https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  ! Access-Control-Allow-Origin

# Fingerprinted CSS and scripts (scripts/build-pages.mjs names each copy after a hash of its contents)
# and the self-hosted fonts (a changed font gets a new file name) never change, so browsers keep them.
# Pages and sw.js keep the default (checked on every visit), which is what lets updates arrive.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Reel posters and thumbnails, icons and the poster-less audio are not renamed when they change, so they
# are not immutable: browsers reuse them for a day and refresh them in the background for a week after.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The sitemap is rebuilt by functions/sitemap.xml.js with posts published since the build.
/sitemap.xml
  Cache-Control: public, max-age=3600

/studio/*
  X-Robots-Tag: noindex, nofollow

# Preview and *.pages.dev addresses stay out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
